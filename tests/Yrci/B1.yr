##

.b1 {
  --b1-bg: #ffffff;
  --b1-fg: #1a1a1a;
  --b1-muted: #6b7280;
  --b1-border: #ececec;
  --b1-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
  --b1-shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.12);

  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
  max-width: 28rem;
  margin: 2rem auto;
  padding: 1.75rem;
  border: 1px solid var(--b1-border);
  border-radius: 16px;
  background: var(--b1-bg);
  box-shadow: var(--b1-shadow);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--b1-fg);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}

@media (prefers-color-scheme: dark) {
  .b1 {
    --b1-bg: #1c1c1e;
    --b1-fg: #f5f5f7;
    --b1-muted: #9ca3af;
    --b1-border: #2c2c2e;
    --b1-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
    --b1-shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.55);
  }
}

@media (max-width: 480px) {
  .b1 {
    margin: 1rem;
    padding: 1.25rem;
    border-radius: 12px;
  }
}

.b1:hover {
  box-shadow: var(--b1-shadow-hover);
  transform: translateY(-2px);
}

.b1__header {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.b1__title {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.b1__subtitle {
  margin: 0;
  font-size: 0.875rem;
  color: var(--b1-muted);
}

.b1__body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 0.875rem 0;
  border-top: 1px solid var(--b1-border);
  border-bottom: 1px solid var(--b1-border);
}

.b1__text {
  margin: 0;
  font-size: 1rem;
  line-height: 1.5;
}

.b1__footer {
  display: flex;
  justify-content: flex-end;
}

.b1__btn {
  padding: 0.55rem 1.15rem;
  border: none;
  border-radius: 8px;
  background: var(--b1-fg);
  color: var(--b1-bg);
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.1s ease;
}

.b1__btn:hover {
  opacity: 0.85;
}

.b1__btn:active {
  transform: scale(0.97);
}

.b1__btn:focus-visible {
  outline: 2px solid var(--b1-fg);
  outline-offset: 2px;
}

